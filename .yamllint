---
extends: default

rules:
  braces:
    max-spaces-inside: 1
    level: error

  hyphens:
    level: error

  line-length: disable

  comments:
    min-spaces-from-content: 1

  comments-indentation: false

  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

  truthy:
    allowed-values: ["true", "false"]
    check-keys: true

  empty-lines:
    max: 2
    max-start: 0
    max-end: 1
